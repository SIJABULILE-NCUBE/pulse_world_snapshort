# Copy this file to .env and fill in your real values.
# Find these in Supabase, under Project Settings, API.

# Your project URL
SUPABASE_URL=https://your-project-ref.supabase.co

# The SERVICE ROLE key, not the anon key.
# This script writes to the database, so it needs the key that can
# bypass row level security. Never put this key in the frontend code,
# it belongs on your machine or a server only.
SUPABASE_SERVICE_KEY=your-service-role-key-here
